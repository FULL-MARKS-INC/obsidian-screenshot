{
	"name": "@obsidian-screenshot/mcp-server",
	"version": "0.1.0",
	"description": "MCP server for browser session management and screenshot capture",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": {
		"obsidian-screenshot-mcp": "./dist/index.js"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"start": "node dist/index.js",
		"postinstall": "playwright install chromium"
