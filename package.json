{
	"name": "obsidian-screenshot",
	"version": "0.1.0",
	"description": "Capture browser screenshots directly from Obsidian notes using Playwright automation",
	"main": "main.js",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"build:mcp-server": "npm run build -w packages/mcp-server",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write \"**/*.{ts,json,md}\"",
		"format:check": "prettier --check \"**/*.{ts,json,md}\"",
		"prepare": "husky"
	},
	"keywords": [
		"obsidian-plugin",
		"obsidian-md",
		"typescript",
		"playwright",
		"screenshot"
	],
	"author": "FULL-MARKS-INC",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@types/node": "^20.10.0",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.20.0",
		"eslint": "^8.57.0",
		"husky": "^9.0.0",
		"lint-staged": "^15.0.0",
		"obsidian": "latest",
		"playwright": "^1.40.0",
		"prettier": "^3.0.0",
		"tslib": "^2.6.0",
		"typescript": "^5.3.0"
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md}": [
			"prettier --write"
		]
	}
}
